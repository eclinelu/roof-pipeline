    "boundary": {
      "tight": "outline follows the real roof edge",
      "short": "outline stops INSIDE the real roof edge; roof continues past it",
      "over": "outline extends PAST the real edge onto something that is not this facet",
      "ragged": "roughly right but jagged where the real edge is straight",
      "cut": "outline CROSSES a real roof feature (ridge, valley, dormer) instead of stopping at it",
